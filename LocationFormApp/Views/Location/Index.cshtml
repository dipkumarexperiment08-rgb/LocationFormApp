@model LocationFormApp.Models.LocationViewModel

<!DOCTYPE html>

<html>

<head>

    <title>Location Form</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 40px;

        }

        .form-group {
            margin-bottom: 20px;

        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        select {
            width: 300px;
            padding: 8px;
            font-size: 16px;
        }

        button {
            padding: 8px 18px;
            cursor: pointer;
        }

        .management {
            margin-top: 40px;
            max-width: 700px;
        }

        .section {
            margin-top: 30px;
        }

        .row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #ddd;
            padding: 10px;
            margin-bottom: 5px;
        }

        .status {
            margin-left: 10px;
            color: gray;
        }

    </style>

</head>


<body>


    <h2>Location Form</h2>

    <!-- LOCATION FORM -->

    <form method="post" action="/Location/Save">


        <!-- COUNTRY -->

        <div class="form-group">

            <label>Country</label>

            <select id="country" name="CountryId">

                <option value="" selected disabled>
                    Select Country
                </option>

                @foreach (var country in Model.Countries)
                {
                    <option value="@country.CountryId">
                        @country.CountryName
                    </option>
                }

            </select>

        </div>


        <!-- STATE -->

        <div class="form-group">

            <label>State</label>

            <select id="state" name="StateId">

                <option value="" selected disabled>
                    Select State
                </option>

            </select>

        </div>


        <!-- CITY -->

        <div class="form-group">

            <label>City</label>

            <select id="city" name="CityId">

                <option value="" selected disabled>
                     Select City
                </option>

            </select>

        </div>


        <button type="submit">
            Save
        </button>


    </form>



    <!-- MANAGEMENT -->

    <div class="management">


        <!-- COUNTRIES -->

        <div class="section">

            <h2>Manage Countries</h2>


            @foreach (var country in Model.AllCountries)
            {
                <div class="row">

                    <div>

                        <strong>
                            @country.CountryName
                        </strong>

                        @if (country.IsActive)
                        {
                            <span class="status">
                                Enabled
                            </span>
                        }
                        else
                        {
                            <span class="status">
                                Disabled
                            </span>
                        }

                    </div>


                    <form method="post"
                          action="/Location/UpdateCountryStatus">

                        <input type="hidden"
                               name="countryId"
                               value="@country.CountryId" />


                        @if (country.IsActive)
                        {
                            <input type="hidden"
                                   name="isActive"
                                   value="false" />

                            <button type="submit">
                                Disable
                            </button>
                        }
                        else
                        {
                            <input type="hidden"
                                   name="isActive"
                                   value="true" />

                            <button type="submit">
                                Enable
                            </button>
                        }

                    </form>

                </div>
            }

        </div>



        <!-- STATES -->

        <div class="section">

            <h2>Manage States</h2>


            @foreach (var state in Model.AllStates)
            {
                <div class="row">

                    <div>

                        <strong>
                            @state.StateName
                        </strong>

                        @if (state.IsActive)
                        {
                            <span class="status">
                                Enabled
                            </span>
                        }
                        else
                        {
                            <span class="status">
                                Disabled
                            </span>
                        }

                    </div>


                    <form method="post"
                          action="/Location/UpdateStateStatus">

                        <input type="hidden"
                               name="stateId"
                               value="@state.StateId" />


                        @if (state.IsActive)
                        {
                            <input type="hidden"
                                   name="isActive"
                                   value="false" />

                            <button type="submit">
                                Disable
                            </button>
                        }
                        else
                        {
                            <input type="hidden"
                                   name="isActive"
                                   value="true" />

                            <button type="submit">
                                Enable
                            </button>
                        }

                    </form>

                </div>
            }

        </div>


        <!-- CITIES -->

        <div class="section">

            <h2>Manage Cities</h2>


            @foreach (var city in Model.AllCities)
            {
                <div class="row">

                    <div>

                        <strong>
                            @city.CityName
                        </strong>

                        @if (city.IsActive)
                        {
                            <span class="status">
                                Enabled
                            </span>
                        }
                        else
                        {
                            <span class="status">
                                Disabled
                            </span>
                        }

                    </div>


                    <form method="post"
                          action="/Location/UpdateCityStatus">

                        <input type="hidden"
                               name="cityId"
                               value="@city.CityId" />


                        @if (city.IsActive)
                        {
                            <input type="hidden"
                                   name="isActive"
                                   value="false" />

                            <button type="submit">
                                Disable
                            </button>
                        }
                        else
                        {
                            <input type="hidden"
                                   name="isActive"
                                   value="true" />

                            <button type="submit">
                                Enable
                            </button>
                        }

                    </form>

                </div>
            }

        </div>

    </div>



    <!-- ===================================== -->
    <!-- JAVASCRIPT -->
    <!-- ===================================== -->

    <script>


        // COUNTRY CHANGE

        document.getElementById("country")
            .addEventListener("change", function () {

                var countryId = this.value;

                var stateDropdown =
                    document.getElementById("state");

                var cityDropdown =
                    document.getElementById("city");


                stateDropdown.innerHTML =
                    '<option value="">-- Select State --</option>';

                cityDropdown.innerHTML =
                    '<option value="">-- Select City --</option>';


                if (countryId === "") {
                    return;
                }


                fetch(
                    "/Location/GetStates?countryId="
                    + countryId
                )

                .then(response => response.json())

                .then(data => {

                    data.forEach(state => {

                        var option =
                            document.createElement("option");

                        option.value =
                            state.stateId;

                        option.textContent =
                            state.stateName;

                        stateDropdown.appendChild(option);

                    });

                })

                .catch(error => {

                    console.error(
                        "State loading error:",
                        error
                    );

                });

            });



        // STATE CHANGE

        document.getElementById("state")
            .addEventListener("change", function () {

                var stateId = this.value;

                var cityDropdown =
                    document.getElementById("city");


                cityDropdown.innerHTML =
                    '<option value="">-- Select City --</option>';


                if (stateId === "") {
                    return;
                }


                fetch(
                    "/Location/GetCities?stateId="
                    + stateId
                )

                .then(response => response.json())

                .then(data => {

                    data.forEach(city => {

                        var option =
                            document.createElement("option");

                        option.value =
                            city.cityId;

                        option.textContent =
                            city.cityName;

                        cityDropdown.appendChild(option);

                    });

                })

                .catch(error => {

                    console.error(
                        "City loading error:",
                        error
                    );

                });

            });


    </script>


</body>

</html>